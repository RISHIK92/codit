# ── Secrets ──────────────────────────────────────────────────────────────────
# Every .env in the tree, not one path per service — a new service that forgets
# to add its own line is exactly how a key gets committed.
.env
.env.*
!.env.example
/gateway/serviceAccountKey.json

# ── Dependencies and build output ────────────────────────────────────────────
node_modules/
dist/
.next/
*.tsbuildinfo

# ── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
