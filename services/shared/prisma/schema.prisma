generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  uid           String   @id
  email         String   @unique
  skillLevel    Skill_Level?
  learningModes String[]
  hoursPerWeek  Int?
  name          String?
  createdAt     DateTime @default(now())

  userProjects        UserProjects[]
  entranceTestAttempt EntranceTestAttempt?
  @@index([email])
}

model Projects {
  id                String    @default(uuid()) @unique
  name              String
  tech_stack        String[]
  skill_level       Skill_Level
  goal              String
  demo_url          String?
  estimated_minutes Int
  initial_files     Json?
  /** Ids of Projects that must be completed before this one is unlockable. */
  prerequisite_ids  String[]  @default([])
  createdAt         DateTime  @default(now())

  learningPhases      LearningPhase[]
  userProjects        UserProjects[]
  deliverables        Deliverable[]
}

model Deliverable {
  id         String   @default(uuid()) @unique
  project_id String
  text       String
  order      Int

  project    Projects @relation(fields: [project_id], references: [id])
}

model EntranceQuestion {
  id             String     @default(uuid()) @unique
  question       String
  options        String[]
  correct_option Int
  description    String
  explanation    String
  difficulty     Difficulty
  topic          String
  createdAt      DateTime   @default(now())
}

model EntranceTestAttempt {
  id           String      @default(uuid()) @unique
  user_email   String      @unique
  status       TestStatus  @default(in_progress)
  round        Int         @default(1)
  answers      Json        @default("[]")
  result_level Skill_Level?
  started_at   DateTime    @default(now())
  completed_at DateTime?

  user         User        @relation(fields: [user_email], references: [email])
}


model ProjectFile {
  id           String   @id @default(uuid())
  project_id   String
  user_email   String
  file_path    String
  content      String   @default("")
  is_directory Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  userProject  UserProjects @relation(fields: [project_id, user_email], references: [project_id, user_email])

  @@unique([project_id, user_email, file_path])
  @@index([project_id, user_email])
}

/** Frozen copy of a user's ProjectFile tree, taken when they advance past a phase — read-only history, not a second editable workspace.
 * File content is stored once as a content-addressed Blob and referenced by hash, so unchanged files across phases (or across users on the
 * same starter files) share one row instead of being duplicated on every phase advance. */
model PhaseSnapshotFile {
  id           String   @id @default(uuid())
  project_id   String
  user_email   String
  phase_number Int
  file_path    String
  blob_hash    String?
  is_directory Boolean  @default(false)
  created_at   DateTime @default(now())

  blob         Blob?    @relation(fields: [blob_hash], references: [hash])

  @@unique([project_id, user_email, phase_number, file_path])
  @@index([project_id, user_email, phase_number])
  @@index([blob_hash])
}

/** Content-addressed storage for snapshot file bodies — keyed by the SHA-256 hash of the content, so identical content is stored exactly once. */
model Blob {
  hash       String   @id
  content    String
  size       Int
  created_at DateTime @default(now())

  phaseSnapshotFiles PhaseSnapshotFile[]
}

model UserProjects {
  id              String   @default(uuid()) @unique
  project_id      String
  user_email      String
  status          Status   @default(in_progress)
  current_phase   Int      @default(0)
  started_at      DateTime @default(now())
  completed_at    DateTime?
  archived        Boolean?  @default(false)

  user            User @relation(fields: [user_email], references: [email])
  projects        Projects @relation(fields: [project_id], references: [id])
  projectFiles    ProjectFile[]
  phaseProgress   UserPhaseProgress[]
  phaseReviews    PhaseReview[]

  @@unique([project_id, user_email])
}

/** One graded submission of a phase for review — the authoritative record of
 * whether a phase goal was judged met. Advancement is driven by rows in this
 * table, never by anything the client asserts: the verdict is parsed from the
 * grader's output server-side, here, and the phase advances in the same
 * transaction that writes the `met` row.
 *
 * Failed submissions are recorded too, deliberately. They are the raw material
 * for measuring how often grading is wrong (the false-MET audit), and later for
 * distinguishing "shipped it" from "understood it" — a user who fails a review,
 * learns why, and passes has demonstrably learned something a single pass/fail
 * flag can't show. */
model PhaseReview {
  id              String        @id @default(uuid())
  user_project_id String
  phase_number    Int
  verdict         ReviewVerdict
  /** The grader's prose feedback, shown back to the user. */
  feedback        String        @default("")
  /** Model that produced the verdict, so a bad batch can be traced later. */
  model           String        @default("")
  created_at      DateTime      @default(now())

  userProject     UserProjects  @relation(fields: [user_project_id], references: [id])
  results         ReviewCriterionResult[]

  @@index([user_project_id, phase_number])
}

/** How one criterion was judged in one submission.
 *
 * The verdict on a phase is the conjunction of these, computed — never a
 * holistic opinion parsed out of prose. Each model-judged row has to carry the
 * file and lines that satisfy the criterion: a model asked "is this good?"
 * drifts generous, while a model required to point at the line has to either
 * find it or fail. That requirement is the main defence against a false pass.
 *
 * Rows are kept for failed submissions too. Measuring how often grading is
 * wrong is impossible from success records alone. */
model ReviewCriterionResult {
  id             String       @id @default(uuid())
  review_id      String
  criterion_id   String
  passed         Boolean
  decided_by     ResultSource
  /** Where the evidence was found. Empty for deterministic checks and failures. */
  evidence_path  String       @default("")
  evidence_lines String       @default("")
  evidence_quote String       @default("")
  /** One sentence on why. Shown to the user when the criterion failed. */
  reasoning      String       @default("")

  review         PhaseReview    @relation(fields: [review_id], references: [id], onDelete: Cascade)
  criterion      PhaseCriterion @relation(fields: [criterion_id], references: [id])

  @@unique([review_id, criterion_id])
  @@index([criterion_id])
}

/** An "explain it back" checkpoint: the user describes, in their own words, how
 * something they built actually works.
 *
 * This is the only mechanism in the system that can evidence comprehension
 * rather than output. Knowledge checks come close but are authored in advance
 * and can be pattern-matched; a review proves the code works, which is not the
 * same claim at all. Someone who prompted their way to a working phase can pass
 * every other gate here and will not pass this one.
 *
 * It is also what fills the `conceptual` criterion slot that Phase 1 left
 * deliberately unauthored, and what clears fog — fog being phases shipped but
 * never explained back. */
model UnderstandingCheckpoint {
  id              String   @id @default(uuid())
  user_email      String
  project_id      String
  phase_number    Int
  /** What they were asked to explain. Stored so a checkpoint stays meaningful
   * after the generating prompt changes. */
  question        String
  answer          String   @default("")
  passed          Boolean  @default(false)
  /** Why it passed or didn't — shown back, and the record of what was missing. */
  feedback        String   @default("")
  /** Concepts the grader judged absent. Feeds what to revisit. */
  missing_concepts String[] @default([])
  model           String   @default("")
  created_at      DateTime @default(now())

  @@index([user_email, project_id])
  @@index([user_email, project_id, phase_number])
}

/** A phase the user has chosen to publish.
 *
 * Sharing requires a PASSED checkpoint on that phase — not merely completing
 * it. A shareable artifact should be evidence of understanding rather than of
 * output, or it becomes exactly the credential-without-substance this product
 * exists to argue against. It also means Show can only ever be earned through
 * Understand, which keeps the four stats from collapsing into "activity".
 *
 * Publishing exposes the user's own code and their explanation to anyone with
 * the link, so it is explicit, per-phase, and revocable at any time. The slug
 * is unguessable rather than sequential, and revoking is honoured immediately;
 * `revoked` rows are kept rather than deleted so a link that once worked can
 * report that it was withdrawn instead of looking broken. */
model SharedArtifact {
  id           String   @id @default(uuid())
  /** Unguessable public identifier. Never the row id or anything enumerable. */
  slug         String   @unique
  user_email   String
  project_id   String
  phase_number Int
  /** Whether the frozen snapshot of their code is published alongside the
   * explanation, or only the criteria and the write-up. Opt-in per share. */
  include_code Boolean  @default(true)
  revoked      Boolean  @default(false)
  view_count   Int      @default(0)
  created_at   DateTime @default(now())

  @@unique([user_email, project_id, phase_number])
  @@index([user_email])
  @@index([slug])
}

enum ResultSource {
  /** Decided in code — no model involved, no judgement to second-guess. */
  deterministic
  /** Decided by a model that cited evidence for its answer. */
  model
  /** The grader errored or returned an unusable answer. Counts as not passed:
   * an unanswered criterion is not a met one. Recorded distinctly so grading
   * failures never get mistaken for judgements about the user's work. */
  ungraded
}

/** Per-user, per-phase status for one enrollment — LearningPhase.phase_status
 * is a shared catalogue field and can't represent per-user progress, since
 * one LearningPhase row is reused by every user enrolled in that project. */
model UserPhaseProgress {
  id              String      @id @default(uuid())
  user_project_id String
  phase_number    Int
  status          PhaseStatus @default(locked)
  completed_at    DateTime?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  userProject     UserProjects @relation(fields: [user_project_id], references: [id])

  @@unique([user_project_id, phase_number])
  @@index([user_project_id])
}

model LearningPhase {
  id                String    @default(uuid()) @unique
  project_id        String
  title             String
  description       String
  long_description  String   @default("")
  concepts          String[]
  goal              Json?
  phase_number      Int
  phase_status      PhaseStatus   @default(locked)
  estimated_minutes Int
  createdAt         DateTime  @default(now())
  
  project         Projects @relation(fields: [project_id], references: [id])
  resources       Resources[]
  knowledgeChecks KnowledgeChecks[]
  criteria        PhaseCriterion[]
}

/** One checkable condition a phase submission must satisfy.
 *
 * Replaces grading against `LearningPhase.goal`, which is a prose sentence. A
 * grader handed prose returns a holistic judgement with no structure to inspect,
 * debug, or count — and holistic judgements drift generous, which is the failure
 * that matters here. Criteria turn one vague verdict into N specific ones, each
 * of which has to be independently evidenced.
 *
 * This is also the contract that later work depends on: the retrieval layer
 * needs "find evidence for criterion 3" to be a well-posed question, the growth
 * stats need `kind` to tell shipping apart from understanding, and generated
 * projects need a definition of what a phase's success condition looks like as
 * data. */
model PhaseCriterion {
  id           String        @id @default(uuid())
  phase_id     String
  /** Display and evaluation order within the phase. */
  order        Int
  /** Specific enough to be checked, in the user's language:
   * "Nav links target section IDs on the same page", not "navigation works". */
  text         String
  kind         CriterionKind
  check_type   CheckType
  /** Shape depends on check_type — see the CheckType docs. Null for model_judged. */
  check_config Json?
  /** Shown when this criterion fails. Names the concept or the thing to look up;
   * never the code, same rule the assistant follows. */
  hint         String        @default("")

  learningPhase LearningPhase @relation(fields: [phase_id], references: [id])
  results       ReviewCriterionResult[]

  @@unique([phase_id, order])
  @@index([phase_id])
}

enum CriterionKind {
  /** The thing does what it should — observable behaviour of the built artifact. */
  behavioral
  /** It's built the way this phase teaches — the structural lesson, not just a
   * result that happens to work. */
  structural
  /** They can articulate why. Feeds the Understand stat rather than Build, and
   * is the only kind that can't be satisfied by code alone. */
  conceptual
}

enum CheckType {
  /** Evaluated in code, no model involved — file exists, parses, matches a
   * pattern, contains an element. Cheap, instant, and impossible to talk out of
   * a verdict, so these run first. */
  deterministic
  /** Requires reading and reasoning about the code. Graded one criterion at a
   * time, and must cite evidence. */
  model_judged
}

model KnowledgeChecks {
  id                String    @default(uuid()) @unique
  phase_id          String
  question          String
  options           String[]  @default([])
  correct_answer    String?
  explanation       String
  question_type     Question_Type

  learningPhase     LearningPhase @relation(fields: [phase_id], references: [id])
  attempts          KnowledgeCheckAttempt[]
}

model KnowledgeCheckAttempt {
  id                  String   @id @default(uuid())
  knowledge_check_id  String
  user_email          String
  project_id          String
  answer              String
  is_correct          Boolean
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  knowledgeCheck      KnowledgeChecks @relation(fields: [knowledge_check_id], references: [id])

  @@unique([knowledge_check_id, user_email])
  @@index([user_email, project_id])
}

model Resources {
  id                String     @default(uuid()) @unique
  phase_id          String
  type              String
  title             String
  url               String
  duration_minutes  Int
  provider          String
  timestamps        Json?
  quality_score     Float

  learningPhase     LearningPhase @relation(fields: [phase_id], references: [id])
  userProgress      ResourceProgress[]
}

model ResourceProgress {
  id          String   @id @default(uuid())
  resource_id String
  user_email  String
  project_id  String
  completed   Boolean  @default(false)
  completed_at DateTime?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  resource    Resources @relation(fields: [resource_id], references: [id])

  @@unique([resource_id, user_email, project_id])
  @@index([user_email, project_id])
}

enum Skill_Level {
  beginner
  intermediate
  advanced
}

enum Status {
  in_progress
  completed
  abandoned
}

enum Question_Type {
  code_completion
  multiple_choice
  debug
}

enum Difficulty {
  easy
  intermediate
  advanced
}

enum TestStatus {
  in_progress
  completed
}

enum PhaseStatus {
  in_progress
  completed
  locked
}

enum ReviewVerdict {
  met
  not_met
  /** Submission never reached the grader — the phase's knowledge checks
   * weren't all answered correctly yet. Recorded rather than dropped so the
   * gate's behaviour is auditable. */
  blocked
}